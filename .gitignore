# 通用忽略规则
# --------------------------------

# 临时文件
*~
*.swp
*.swo
*.tmp
*.bak

# 日志文件
*.log
logs/
*.log.*

# 编译和构建产物
dist/
build/
out/
target/
*.o
*.obj
*.exe
*.dll
*.so
*.class
*.jar

# 依赖目录
node_modules/
vendor/
bower_components/
*.lock

# 环境变量和敏感文件
.env
.env.local
.env.*.local
*.env
*.secret
*.key
*.pem

# 操作系统生成的文件
.DS_Store           # macOS
Thumbs.db           # Windows
desktop.ini         # Windows

# IDE 和编辑器文件
.idea/              # IntelliJ IDEA
*.iml               # IntelliJ IDEA
.vscode/            # Visual Studio Code
*.sublime-*         # Sublime Text
*.code-workspace

# 缓存文件
.cache/
*.cache
*.pyc               # Python 字节码
__pycache__/
.pytest_cache/
*.egg-info/

# 测试和覆盖率报告
coverage/
.coverage
*.cover
*.lcov

# 打包和压缩文件
*.zip
*.tar.gz
*.rar
*.7z

# 数据库相关
*.sql
*.sqlite
*.db

# 文档生成
_site/
docs/_build/

# 其他常见忽略
*.bak
*.gho
*.orig
*.rej
*.suo
*.ncb
*.user

# 特定语言/框架补充（可根据需要启用）
# --------------------------------

# Node.js
npm-debug.log
yarn-error.log
yarn-debug.log

# Python
*.py[cod]
*.egg
*.eggs/
*.whl
venv/
env/
*.venv/

# Java
*.class
*.war
*.ear
*.nar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# Ruby
*.gem
.bundle/
Gemfile.lock

# Go
*.exe
*.test
*.prof

# PHP
vendor/
composer.lock
*.php_cs.cache

# 保留特定文件（可选）
# --------------------------------
!.gitignore         # 保留 .gitignore 本身
!.env.example       # 保留环境变量模板
!*.md               # 保留 Markdown 文件
!*.txt              # 保留特定文本文件

# 项目特定目录（根据需要调整）
# --------------------------------
/temp/              # 忽略根目录下的 temp 文件夹
/cache/             # 忽略缓存目录