#!/bin/bash
# Wrapper script for Cursor editor on macOS
# This allows Storybook and other tools to open files in Cursor

# Get the file path from arguments
FILE_PATH="$1"

# Use macOS 'open' command to open the file in Cursor
if [ -n "$FILE_PATH" ]; then
  open -a Cursor "$FILE_PATH"
else
  open -a Cursor
fi
